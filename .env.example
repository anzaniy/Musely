# Salin file ini menjadi ".env" lalu isi nilainya.
# JANGAN commit file ".env" ke git.

# ---------------------------------------------------------------
# Spotify (opsional jika memakai GSMTC sebagai sumber utama)
# ---------------------------------------------------------------

# Client ID dari https://developer.spotify.com/dashboard
# Client Secret TIDAK dipakai karena kita memakai PKCE.
SPOTIFY_CLIENT_ID=

# Harus sama persis dengan yang didaftarkan di dashboard.
# Gunakan loopback IP, bukan "localhost".
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Port lokal untuk menangkap callback OAuth.
SPOTIFY_CALLBACK_PORT=8888

# Scope dipisah spasi.
SPOTIFY_SCOPES=user-read-currently-playing user-read-playback-state

# ---------------------------------------------------------------
# LRCLIB (tidak butuh API key)
# ---------------------------------------------------------------

LRCLIB_BASE_URL=https://lrclib.net

# Wajib: identifikasi aplikasi. Ganti dengan nama & URL proyekmu.
LRCLIB_USER_AGENT=SpotifyLyricsWidget v0.1.0 (https://github.com/USERNAME/spotify-lyrics-widget)

# Opsional: isi jika sudah mendaftar di https://lrclib.net/developers
LRCLIB_APP_ID=

# ---------------------------------------------------------------
# Perilaku aplikasi
# ---------------------------------------------------------------

# Interval polling playback (ms). Jangan di bawah 500.
POLL_INTERVAL_MS=500

# Interval polling Spotify API (ms). Jangan di bawah 1000.
SPOTIFY_POLL_INTERVAL_MS=2000

# TTL cache lirik (hari)
LYRICS_CACHE_TTL_DAYS=30

# Offset default lirik (ms), positif = lirik lebih lambat
LYRICS_OFFSET_MS=0

# true = pakai GSMTC (tanpa login), false = pakai Spotify API
USE_GSMTC=true